<?xml version="1.0" encoding="utf-8"?>
<!--
    Fixed RemoteViews surface for the multi-cart quick-log widget. The
    renderer replaces the placeholder text and toggles the cart grid,
    overflow row, and undo state as data becomes available.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_multi_cart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_multi_cart_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="@string/pen_widget_label"
        android:textColor="@color/widget_on_background"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_multi_cart_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_multi_cart_button_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_step_button"
            android:ellipsize="end"
            android:maxLines="2"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:stateListAnimator="@null"
            android:text="@string/pen_widget_generic_cart"
            android:textColor="@color/widget_on_step"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_multi_cart_button_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_step_button"
            android:ellipsize="end"
            android:maxLines="2"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:stateListAnimator="@null"
            android:text="@string/pen_widget_generic_cart"
            android:textColor="@color/widget_on_step"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_multi_cart_button_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_step_button"
            android:ellipsize="end"
            android:maxLines="2"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:stateListAnimator="@null"
            android:text="@string/pen_widget_generic_cart"
            android:textColor="@color/widget_on_step"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_multi_cart_button_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_step_button"
            android:ellipsize="end"
            android:maxLines="2"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:stateListAnimator="@null"
            android:text="@string/pen_widget_generic_cart"
            android:textColor="@color/widget_on_step"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_multi_cart_overflow"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_submit_button"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="4dp"
        android:stateListAnimator="@null"
        android:textColor="@color/widget_on_submit"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_multi_cart_undo_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/widget_multi_cart_undo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_submit_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:stateListAnimator="@null"
            android:text="@string/pen_widget_undo_symbol"
            android:textColor="@color/widget_on_submit"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_multi_cart_undo_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/widget_on_background_muted"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
